{
  "schema": "ohe.telemetry.attributes/1",
  "attributes": [
    {
      "key": "service.name",
      "type": "string",
      "healthDerived": false,
      "domain": ["open-health-exporter"],
      "justification": "Names the locally built service in the user's collector."
    },
    {
      "key": "ohe.destination.id",
      "type": "string",
      "healthDerived": false,
      "domain": ["opaque local identifier", "other"],
      "justification": "Keys per-destination freshness gauges without exporting a label or address; the metric projector bounds active values to eight slots."
    },
    {
      "key": "outcome",
      "type": "string",
      "healthDerived": false,
      "domain": [
        "success",
        "successNothingDue",
        "partial",
        "unknownAck",
        "failed",
        "abandonedNoBudget",
        "cancelledBySystem",
        "blockedDeviceLocked",
        "localNetworkDenied",
        "blockedLowPower",
        "blockedUnmetered"
      ],
      "justification": "Projects the closed journal outcome without free-form detail."
    },
    {
      "key": "trigger",
      "type": "string",
      "healthDerived": false,
      "domain": [
        "manual",
        "shortcut",
        "observerQuery",
        "bgAppRefresh",
        "bgProcessing",
        "appForeground",
        "widgetControl",
        "launch"
      ],
      "justification": "Projects the closed run trigger for user-owned operational analysis."
    }
  ]
}
