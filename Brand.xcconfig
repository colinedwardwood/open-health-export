// D-06: the product is KeepMyMetrics (owner decision 2026-09-25; counsel clearance in #22).
// This is the only file that may contain a user-visible product name.
PRODUCT_NAME = KeepMyMetrics
// The App Store name, which store/en/name.txt must match.
STORE_NAME = KeepMyMetrics
// The label under the icon, and the name iOS shows in Settings and in Health's app
// list. Kept to 12 characters so it does not truncate on the home screen.
DISPLAY_NAME = Keep Metrics

// #11 / #35: the neutral, owner-held root every identifier derives from: bundle IDs,
// the App Group, background tasks, the URL scheme, keychain services and log
// subsystems. It carries no product name, so the name can change without stranding
// credentials or App Store records. scripts/rename-drill.sh proves nothing else
// hard-codes it.
PRODUCT_BUNDLE_IDENTIFIER_ROOT = com.cewdesign.exporter
APP_GROUP_IDENTIFIER = group.$(PRODUCT_BUNDLE_IDENTIFIER_ROOT)
