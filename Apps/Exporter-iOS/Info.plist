<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>OHEAppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.openhealthexporter.status</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openhealthexporter</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.openhealthexporter.refresh</string>
		<string>app.openhealthexporter.processing</string>
		<string>app.openhealthexporter.backfill</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>This app reads the Health types you select so it can export them to destinations you configure. It does not diagnose or treat any condition.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app does not write health records. Apple requires this statement because the HealthKit capability is enabled.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ohx-recv._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>The exporter finds your Mac companion on this network so it can push batches you approved. The iPhone does not accept incoming connections.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used only to read a pairing QR from your Mac. The image is not stored or sent anywhere.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
